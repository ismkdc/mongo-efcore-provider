<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>Official MongoDB supported provider for Entity Framework Core. See https://www.mongodb.com/docs/entity-framework/ for more details.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>MongoDB.EntityFrameworkCore</PackageId>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>EF1001</NoWarn>
    <Nullable>enable</Nullable>
    <Features>$(Features);runtime-async=on</Features>
    <DefineConstants>$(DefineConstants);EF11</DefineConstants>
  </PropertyGroup>

  <Import Project="..\..\Versions.props" />
  <Import Project="..\..\ismkdc.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="MongoDB.EntityFrameworkCore.UnitTests" />
    <InternalsVisibleTo Include="MongoDB.EntityFrameworkCore.SpecificationTests" />
    <InternalsVisibleTo Include="MongoDB.EntityFrameworkCore.FunctionalTests" />
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
    <PackageReference Include="MongoDB.Driver" Version="$(CSharpDriverVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EF11Version)" />
  </ItemGroup>
</Project>
