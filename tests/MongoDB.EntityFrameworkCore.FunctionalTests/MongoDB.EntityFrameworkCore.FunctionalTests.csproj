<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <DefineConstants>$(DefineConstants);EF11</DefineConstants>
  </PropertyGroup>

  <Import Project="..\..\Versions.props" />

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MongoDB.EntityFrameworkCore\MongoDB.EntityFrameworkCore.csproj" />
    <PackageReference Include="MongoDB.Driver.Encryption" Version="$(CSharpDriverVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EF11Version)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="$(EF11Version)" />
    <Compile Remove="Design\Generated\**" />
    <Compile Include="Design\Generated\EF11\**" />
  </ItemGroup>
</Project>
