<Project>
  <PropertyGroup>
    <!-- This fork targets net11.0 only. NuGet restore outputs (project.assets.json,
         *.nuget.g.props/targets, etc.) are written to $(MSBuildProjectExtensionsPath), which defaults
         to the *unqualified* obj\ directory; give each configuration its own subdirectory so parallel
         Debug/Release builds do not race on those files. Leave BaseIntermediateOutputPath (compiled
         output) untouched, since it is already segregated by configuration. -->
    <MSBuildProjectExtensionsPath>obj\$(Configuration)\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
